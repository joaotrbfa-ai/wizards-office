# ---- Resend (envio do formulário de brief em /contato) ----

# API key do Resend (https://resend.com → API Keys). Obrigatória.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remetente. Só funciona com o domínio verificado no Resend.
# Antes da verificação, use o sandbox (envia só para o e-mail dono da conta Resend):
#   BRIEF_FROM_EMAIL="Wizards Office <onboarding@resend.dev>"
BRIEF_FROM_EMAIL="Wizards Office <brief@wizardsoffice.com>"

# Destinatário dos briefs recebidos.
BRIEF_TO_EMAIL="contato@wizardsoffice.com"


# ---- Sanity CMS (Studio embutido em /admin) ----

# ID do projeto Sanity (dashboard Sanity → Project settings). Obrigatória.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset. Use "production".
NEXT_PUBLIC_SANITY_DATASET=production

# Versão da API (data, formato YYYY-MM-DD). Não mude sem motivo.
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Token de ESCRITA (permissão Editor) — usado SÓ pelo script de migração local.
# Crie em: sanity.io/manage → API → Tokens → "Add API token" (Editor).
# ⚠️ NÃO adicionar este token na Vercel — uso exclusivamente local.
SANITY_API_WRITE_TOKEN=

# Token de LEITURA (permissão Viewer) — fetch server-side (SSG).
# O dataset é público, então é opcional; recomendado para futuro/consistência.
# Adicionar em .env.local E na Vercel (Production + Preview + Development).
SANITY_API_READ_TOKEN=

# Segredo do webhook de revalidação on-demand. Gere uma string forte (32+ chars)
# e use o MESMO valor no Sanity → API → Webhooks. Local + Vercel.
SANITY_REVALIDATE_SECRET=
