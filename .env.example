# ---- Resend (envio do formulário de brief em /contato) ----

# API key do Resend (https://resend.com → API Keys). Obrigatória.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remetente. Só funciona com o domínio verificado no Resend.
# Antes da verificação, use o sandbox (envia só para o e-mail dono da conta Resend):
#   BRIEF_FROM_EMAIL="Wizards Office <onboarding@resend.dev>"
BRIEF_FROM_EMAIL="Wizards Office <brief@wizardsoffice.com>"

# Destinatário dos briefs recebidos.
BRIEF_TO_EMAIL="contato@wizardsoffice.com"
